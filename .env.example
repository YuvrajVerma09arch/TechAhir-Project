# Copy to .env to override defaults. No secrets are needed — this app is fully offline.

APP_TITLE=Support Ticket Triage API
APP_DESCRIPTION=Offline, confidence-aware support ticket triage with human review.
VERSION=1.0.0

# SQLite persistence location (relative paths resolve from the repository root for data,
# and from the process working directory for the DB).
DB_PATH=artifacts/triage.db
DATA_PATH=data/tickets.csv

# Confidence routing: auto-accept only when BOTH category and priority pass their threshold.
CATEGORY_CONFIDENCE_THRESHOLD=0.65
PRIORITY_CONFIDENCE_THRESHOLD=0.55

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# Optional LLM caution judge — OFF by default. The rules engine remains the only
# classifier; the judge can only ADD human review, never change a decision.
# Requires BOTH the enabled flag and a key. Uses an OpenAI-compatible endpoint.
LLM_JUDGE_ENABLED=false
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_JUDGE_TIMEOUT_SECONDS=3
